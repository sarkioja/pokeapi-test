# Application
PORT=3000
NODE_ENV=development

# Database — local (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pokeapi_dev
# DB_SCHEMA=           # Deixe vazio para produção; testes definem 'test' automaticamente

# Database — remote (Neon.tech — overrides individual vars above when set)
DATABASE_URL=

# PokéAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEMON_TTL_HOURS=24
POKEMON_TYPE_TTL_DAYS=7
HTTP_TIMEOUT_MS=5000

# ViaCEP
VIACEP_BASE_URL=https://viacep.com.br/ws

# Security — REQUIRED, app will not start if empty
API_KEYS=change-me-dev-key-1,change-me-dev-key-2

# CORS
CORS_ORIGINS=http://localhost:3000

# Logs
LOG_LEVEL=info
